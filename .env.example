# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="RAG Document System"
ENVIRONMENT=development      # development | production
DEBUG=true
LOG_LEVEL=INFO

# ─── Security ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=ragdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://raguser:ragpassword@localhost:5432/ragdb

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redispassword
REDIS_URL=redis://:redispassword@localhost:6379/0
CACHE_TTL_SECONDS=3600       # 1 hour query cache TTL

# ─── Qdrant Vector Store ──────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=documents

# ─── Groq AI ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_EMBEDDING_MODEL=nomic-embed-text    # used via Ollama or compatible endpoint
GROQ_CHAT_MODEL=llama-3.3-70b-versatile # best Groq model
GROQ_SUMMARIZE_MODEL=llama-3.3-70b-versatile

# ─── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSIONS=768     # nomic-embed-text dimensions

# ─── Retrieval ────────────────────────────────────────────────────────────────
DEFAULT_TOP_K=5
CONFIDENCE_THRESHOLD=0.4

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_QUERY=10/minute

# ─── File Upload ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=/app/uploads
ALLOWED_EXTENSIONS=["pdf","docx","eml","msg"]

# ─── Celery Flower ────────────────────────────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=flowerpassword
